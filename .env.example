# Telegram
BOT_TOKEN=your_telegram_bot_token_here

# OpenAI (Whisper STT + GPT-4o-mini NLP)
OPENAI_API_KEY=sk-your_openai_key_here

# PostgreSQL (для Docker)
POSTGRES_USER=balancy
POSTGRES_PASSWORD=balancy_pass
POSTGRES_DB=balancy
DATABASE_URL=postgresql+asyncpg://balancy:balancy_pass@db:5432/balancy

# Для локального запуска без Docker (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./balancy.db

# Mini App URL (ngrok)
# Запусти: ngrok http 8000
# Затем скопируй HTTPS URL и добавь /miniapp:
MINIAPP_URL=https://xxxx-xxx-xxx.ngrok-free.app/miniapp

# API Server
API_HOST=0.0.0.0
API_PORT=8000

DEBUG=True
